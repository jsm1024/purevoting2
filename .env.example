# Copy to .env and fill in. Never commit .env (secrets).
# Values marked <set> differ per deployment; use fresh signer keys for every deployment (hashing.md "Replay across deployments").

# ---- ports ----
CORE_PORT=8000
GATEWAY_PORT=8100
WEB_PORT=3000
NODE_RPC_PORT=8545          # first validator node JSON-RPC (others per ledger/ compose)
MAILHOG_UI_PORT=8025        # development mail UI (D-16)
POSTGRES_PORT=5432

# ---- database (D-06: one database, schemas credential and ballot owned by different roles) ----
POSTGRES_DB=purevoting
POSTGRES_SUPERUSER_PASSWORD=<set>
DB_CORE_PASSWORD=<set>          # login role pv2_core (the schema owners pv2_credential / pv2_ballot cannot log in)

# ---- service keys (X-Service-Key, one per service; README "Permission matrix") ----
CORE_KEY=<set>          # Core -> Gateway
RULE_KEY=<set>          # Rule Engine -> Core / Gateway
AGENT_KEY=<set>         # Audit Agent -> Core / Gateway (read only + reports)
GATEWAY_KEY=<set>       # Gateway -> Core (logs, ANCHOR_REJECTED alerts)
AUDITOR_KEY=<set>       # read-only Gateway key for organizations / invited auditors

# ---- staff JWT ----
JWT_SECRET=<set>

# ---- pinned chain configuration (chain-interface.md; confirmed by every organization) ----
CHAIN_ID=<set>
CONTRACT_ADDRESS=<set>
PINNED_NODE_URL=<set>   # a node run by an organization other than the Gateway operator (demo: org_observer)

# ---- demo organizations (D-21: each registers its own signer on chain) ----
# ORG_*_SIGNER_KEY: read only by the registry setup script and the scenario scripts — never by Core (approvers load their
# key into the admin web). RULE_ENGINE_SIGNER_KEY is used only by the Rule Engine, GATEWAY_ACCOUNT_KEY only by the Gateway.
# Key generation script: Harits (ledger/), fresh keys for every deployment.
ORG_COMMISSION_SIGNER_KEY=<set>   # operator org
ORG_OBSERVER_SIGNER_KEY=<set>
ORG_NEUTRAL_SIGNER_KEY=<set>      # operates Gateway, Rule Engine, AI
RULE_ENGINE_SIGNER_KEY=<set>      # registered as ruleEngineSigner
GATEWAY_ACCOUNT_KEY=<set>         # registered as gatewayAccount
ORG_COMMISSION_NODE_ACCOUNT_KEY=<set>   # node accounts that write registry entries (hashing.md "Registry")
ORG_OBSERVER_NODE_ACCOUNT_KEY=<set>
ORG_NEUTRAL_NODE_ACCOUNT_KEY=<set>
RULE_ENGINE_CHAIN_ACCOUNT_KEY=<set>     # pays for direct submitFindingRecord (optional path)

# ---- demo election settings (used only by demo scripts; Core never applies a default bucket, D-10) ----
DEMO_TIME_BUCKET_SECONDS=60
DEMO_CHECKPOINT_INTERVAL_SECONDS=60

# ---- Gateway batching (D-04, fixed values) ----
ANCHOR_BATCH_SECONDS=60
ANCHOR_BATCH_MAX_EVENTS=50

# ---- AI Audit Agent (optional; model chosen by Anik, D-15) ----
AI_API_KEY=<set>
